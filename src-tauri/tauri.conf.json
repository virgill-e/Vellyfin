{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellyfin",
  "version": "0.3.0",
  "identifier": "com.vellyfin.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vellyfin",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http: ws://localhost:*",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' blob: asset: http://asset.localhost https: http:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/downloads/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMDU3REE0NTVDNkQzMUUKUldRZTA4WlZwSDBGNE1yaCtzV1JiSWhVTVFVWVRJWHM0YXVFTnZUSTNseDMvTU1FeVVsLzV6TG4K",
      "endpoints": [
        "https://github.com/virgill-e/Vellyfin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
